# Gilhari RESTful microservice: excel-poc-service
# Generated by orm_skyway.py
# Builds on the base Gilhari image (REST server pre-installed).
ARG BASE_PLATFORM=linux/amd64
FROM --platform=${BASE_PLATFORM} softwaretree/gilhari

WORKDIR /opt/excel-poc-service

# bin/ includes all .class files (top-level and inner classes)
# config/ includes .docker.jdx ORM spec, JDBC driver JAR, classnames_map.json
# Build context is the project root (see build.cmd/build.sh: docker build -f gilhari/Dockerfile .)
# so these ADD sources are still root-relative even though this Dockerfile lives in gilhari/.
ADD bin ./bin
ADD config ./config
ADD gilhari/gilhari_service.config .

# File-based database: NOT embedded -- mounted at runtime via -v flag.
# See run_docker_app.cmd / run_docker_app.sh for the mount command.

EXPOSE 8081

CMD ["node", "/node/node_modules/gilhari_rest_server/gilhari_rest_server.js", "gilhari_service.config"]
